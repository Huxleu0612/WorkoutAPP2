# Copy to .env and fill in from the Supabase dashboard: Settings -> API.
# Both are safe to expose in the built bundle — the anon key identifies the project and
# grants nothing on its own. Row Level Security is what protects your rows.
# Leave these unset and the app runs fully local with no sign-in and no sync.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
